---
import Features2 from "~/components/widgets/Features2.astro";
import Features3 from "~/components/widgets/Features3.astro";
import Hero from "~/components/widgets/Hero.astro";
import Stats from "~/components/widgets/Stats.astro";
import Steps2 from "~/components/widgets/Steps2.astro";
import Layout from "~/layouts/PageLayout.astro";
import heroImage from "~/assets/images/about/hero.png";

const metadata = {
  title: "海上アングラーについて",
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Kaijo Angler"
    image={{
      src: heroImage,
      alt: "海上釣り堀の風景",
    }}
  >
    <Fragment slot="title">
      海上釣り堀の感動を、<br />
      <span class="text-accent dark:text-white">すべてのアングラーへ。</span>
    </Fragment>

    <Fragment slot="subtitle">
      「海上アングラー」は、全国<strong>100施設以上</strong>・<strong
        >35都道府県</strong
      >の海上釣り堀情報と<strong>90本以上</strong
      >の攻略記事をまとめた、海上釣り堀専門の個人サイトです。
      初めての方にも経験者にも、施設選びと当日の釣りに役立つ情報をお届けします。
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="数字で見る海上アングラー"
    stats={[
      { title: "掲載施設数", amount: "100+" },
      { title: "掲載都道府県", amount: "35" },
      { title: "攻略記事", amount: "90+" },
      { title: "魚種別ガイド", amount: "14" },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="提供するコンテンツ"
    subtitle="私は「情報の正確性」と「アングラー目線」を大切にしています。"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: "全国100施設以上のガイド",
        description:
          "全国35都道府県の施設を掲載。料金・営業時間・放流魚種・設備情報を、各施設の公式情報をもとに整理しています。",
        icon: "tabler:map-pin",
      },
      {
        title: "魚種別の攻略テクニック",
        description:
          "マダイ・ブリ・シマアジ・クエなど14の魚種別ガイドを用意。90本以上の記事で、ターゲットごとの棚・餌・合わせを解説しています。",
        icon: "tabler:target",
      },
      {
        title: "タックル紹介",
        description:
          "初心者向けのセットから、魚種に合わせた専用竿まで。道具選びで迷ったときの判断材料をまとめています。",
        icon: "tabler:fish",
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="このサイトで大切にしていること"
    subtitle="釣りの楽しさを伝え、豊かな海と家族の絆を育む。"
    items={[
      {
        title: "「手ぶら」から始まる感動を",
        description:
          "釣りは道具が多くて難しい。そんな先入観を減らし、手ぶらでも海の釣りを楽しめることを伝えていきます。",
      },
      {
        title: "持続可能な釣り文化の醸成",
        description:
          "マナーやルールの情報も一緒に載せ、次の世代のアングラーに豊かな海を残すことにつなげたいと考えています。",
      },
      {
        title: "釣った魚を食べる楽しみ",
        description:
          "自分で釣った魚をおいしく食べる。そこまで含めて楽しめるのが、海上釣り堀の大きな魅力だと思っています。",
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="運営・プロフィール"
    tagline="About Admin"
    columns={2}
    items={[
      {
        title: "さしし (運営・執筆)",
        description:
          "釣り歴20年以上のアングラーライター。もともと海釣りをしていましたが、釣れにくくなってからは淡水の管理釣り場に通うようになりました。海上釣り堀ならブリやマダイのような大物が釣れると知り、「楽しそう！」と調べ始めたのがこのサイトのきっかけです。管理された釣り場で大物に出会える海上釣り堀は、これからの釣りのスタンダードになると考えています。",
        icon: "tabler:user",
        callToAction: {
          text: "公式X (旧Twitter)",
          href: "https://x.com/sasisi344",
          target: "_blank",
        },
      },
      {
        title: "お問い合わせ",
        description:
          "取材・撮影依頼、広告掲載、記事内容に関するご相談は、下記Googleフォームよりお気軽にご連絡ください。<br />内容を確認のうえ、順次お返事します。",
        icon: "tabler:mail",
        callToAction: {
          text: "お問い合わせフォーム",
          href: "https://docs.google.com/forms/d/e/1FAIpQLSegPHwMqUtKjHl0y1OTPrNr0aaW7Hmt7jluuZ9FUQYdv362Dg/viewform?usp=sf_link",
          target: "_blank",
        },
      },
    ]}
  />
</Layout>
