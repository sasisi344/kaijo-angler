---
import { getCurrentFacilities, countByType } from "~/utils/fishing-facility-collection";
import { evaluateFirstTimer, isFirstTimerPick } from "~/utils/first-timer";
import { normalizeAmenityValue } from "~/utils/facility-helpers";
import Layout from "~/layouts/PageLayout.astro";
import Hero from "~/components/widgets/Hero.astro";
import Stats from "~/components/widgets/Stats.astro";
import Headline from "~/components/blog/Headline.astro";
import MapApp from "~/components/widgets/MapApp.astro";
import Image from "~/components/common/Image.astro";
import type { ImageMetadata } from "astro";
import { getPermalink } from "~/utils/permalinks";

// 今行く候補（閉業・休止を除き、期間のある休業は含む）。件数・検索ともここが母数
const entries = await getCurrentFacilities();

// 地域ランキングと同じ7地域。県の並びは北から
const AREAS = [
  { key: "tohoku-hokkaido", name: "東北・北海道", prefs: ["hokkaido", "aomori", "iwate", "miyagi", "akita", "yamagata", "fukushima"] },
  { key: "kanto-tokai", name: "関東・東海", prefs: ["ibaraki", "chiba", "tokyo", "kanagawa", "shizuoka", "aichi", "gifu"] },
  { key: "nihonkai-hokuriku", name: "日本海・北陸", prefs: ["niigata", "toyama", "ishikawa", "fukui"] },
  { key: "mie-wakayama", name: "三重・和歌山", prefs: ["mie", "wakayama"] },
  { key: "kansai", name: "関西", prefs: ["kyoto", "osaka", "hyogo", "nara", "shiga"] },
  { key: "chugoku-shikoku", name: "中国・四国", prefs: ["okayama", "hiroshima", "yamaguchi", "tottori", "shimane", "kagawa", "tokushima", "ehime", "kochi"] },
  { key: "kyushu-okinawa", name: "九州・沖縄", prefs: ["fukuoka", "saga", "nagasaki", "kumamoto", "oita", "miyazaki", "kagoshima", "okinawa"] },
];
const PREF_ORDER = AREAS.flatMap((a) => a.prefs);
const areaOf = (pref?: string) => AREAS.find((a) => a.prefs.includes(pref ?? ""))?.key ?? "";

const TYPE_LABEL: Record<string, string> = {
  "sea-pond": "海上釣り堀",
  "sea-park": "海釣り施設",
  raft: "釣り筏",
  other: "その他",
};

const prefName = (title: string) => title.match(/^【([^】]+)】/)?.[1] ?? "";
const shortTitle = (title: string) => title.split("｜")[0].replace(/^【[^】]*】/, "");

/** yes / no / unknown。書かれていない項目を「なし」にしない */
const rentalState = (v: unknown) => (v === undefined || v === null || v === "" ? "unknown" : normalizeAmenityValue(v) ? "yes" : "no");
const reservationState = (t?: string) =>
  t === "not_required" || t === "first_come" ? "yes" : t === "required" || t === "recommended" ? "no" : "unknown";

const cards = entries
  .map((post) => {
    const d = post.data;
    const fd = d.facility_details;
    const ft = evaluateFirstTimer(fd);
    return {
      slug: d.slug as string,
      title: shortTitle(d.title),
      pref: d.prefecture ?? "",
      prefName: prefName(d.title),
      area: areaOf(d.prefecture),
      type: d.facilityType ?? "",
      image: (d.image || d.featureimage) as ImageMetadata | string | undefined,
      price: fd?.average_price ?? "",
      reservation: fd?.reservation ?? "",
      verifiedAt: fd?.verified_at ?? fd?.first_timer?.verified_at ?? "",
      rental: rentalState(fd?.amenities?.rental_tackle),
      noReservation: reservationState(fd?.reservation_type),
      fish: (fd?.target_fish ?? []).join("|"),
      firstTimer: isFirstTimerPick(ft) ? "yes" : ft?.level === "experienced" ? "no" : "unknown",
      closures: JSON.stringify((fd?.seasonal_closures ?? []).map((c) => ({ from: c.from, to: c.to ?? null, reopen: c.reopen ?? null }))),
      href: getPermalink(`fishing-facility/${d.slug}`),
    };
  })
  .sort((a, b) => PREF_ORDER.indexOf(a.pref) - PREF_ORDER.indexOf(b.pref) || a.title.localeCompare(b.title, "ja"));

const firstTimerCount = cards.filter((c) => c.firstTimer === "yes").length;
const prefectureCount = new Set(cards.map((c) => c.pref).filter(Boolean)).size;
const pondCount = countByType(entries, "sea-pond");

// 県の入口（初期 HTML に出す）。県別ページは記事のフォルダから自動で作られる
const areaLinks = AREAS.map((area) => {
  const prefs = area.prefs
    .map((pref) => {
      const list = cards.filter((c) => c.pref === pref);
      const sample = entries.find((p) => p.data.prefecture === pref);
      if (!list.length || !sample?.data.region) return null;
      return {
        name: list[0].prefName || pref,
        count: list.length,
        ponds: list.filter((c) => c.type === "sea-pond").length,
        href: getPermalink(`/fishing-facility/${sample.data.region}/${pref}`),
      };
    })
    .filter((p): p is NonNullable<typeof p> => Boolean(p));
  return { ...area, prefs, ranking: getPermalink(`/column/ranking/${area.key}`) };
}).filter((a) => a.prefs.length);

const inputCls = "w-full font-normal text-sm p-2 rounded border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800";

const FISH_OPTIONS = ["マダイ", "ブリ", "カンパチ", "シマアジ", "ヒラマサ", "クエ", "イシダイ", "アジ", "タチウオ", "クロダイ"];

const metadata = {
  title: "海上釣り堀を探す｜全国の施設を地域・種類・行く日で絞り込み",
  description: `全国${pondCount}か所の海上釣り堀と、海釣り施設・釣り筏を地域・種類・行く日で絞り込めます。冬の休業期間に入る施設は自動で外し、料金・予約・確認日を同じ形で比べられます。`,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="釣り場検索"
    title="全国の海上釣り堀・海釣り施設を探す"
    subtitle={`${prefectureCount}都道府県・${cards.length}施設（閉業・休止中を除く）から、地域・種類・行く日で絞り込めます。冬季休業などの期間に入る施設は、行く日に合わせて自動で外します。`}
  />

  <Stats
    stats={[
      { title: "海上釣り堀", amount: String(pondCount) },
      { title: "海釣り施設", amount: String(countByType(entries, "sea-park")) },
      { title: "釣り筏", amount: String(countByType(entries, "raft")) },
      { title: "都道府県", amount: String(prefectureCount) },
    ]}
  />

  <!-- 条件で探す ****************** -->
  <section id="search" class="px-4 md:px-6 py-10 mx-auto max-w-7xl">
    <Headline
      title="条件で探す"
      subtitle="地域・種類・行く日で候補を絞り、希望の条件に合う施設から並べます。施設記事に書かれていない項目は「未確認」と表示し、合わない扱いにはしません。"
    />

    <form id="fs-form" class="k-card p-4 md:p-6 grid gap-4 md:grid-cols-4" onsubmit="return false;">
      <label class="text-sm font-bold flex flex-col gap-1">
        地域
        <select name="area" class={inputCls}>
          <option value="">全国</option>
          {AREAS.map((a) => <option value={a.key}>{a.name}</option>)}
        </select>
      </label>
      <label class="text-sm font-bold flex flex-col gap-1">
        施設の種類
        <select name="type" class={inputCls}>
          <option value="sea-pond" selected>海上釣り堀</option>
          <option value="sea-park">海釣り施設</option>
          <option value="raft">釣り筏</option>
          <option value="">すべて</option>
        </select>
      </label>
      <label class="text-sm font-bold flex flex-col gap-1">
        行く日
        <input type="date" name="date" class={inputCls} />
      </label>
      <label class="text-sm font-bold flex items-center gap-2 md:mt-6">
        <input type="checkbox" name="showClosed" />
        この日に休業の施設も表示する
      </label>

      <fieldset class="md:col-span-4 border-t border-gray-200 dark:border-slate-700 pt-4">
        <legend class="text-sm font-bold">希望の条件（合う施設から並べます）</legend>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <label class="flex items-center gap-2"><input type="checkbox" name="rental" />竿を借りたい</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="noReservation" />予約なしで行きたい</label>
          {firstTimerCount > 0 && (
            <label class="flex items-center gap-2"><input type="checkbox" name="firstTimer" />はじめてでも安心（確認済み）</label>
          )}
          <label class="flex items-center gap-2 whitespace-nowrap">
            狙いたい魚
            <select name="fish" class="font-normal text-sm py-1 px-2 rounded border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800">
              <option value="">指定しない</option>
              {FISH_OPTIONS.map((f) => <option value={f}>{f}</option>)}
            </select>
          </label>
        </div>
      </fieldset>

      <div class="md:col-span-4 flex flex-wrap items-center justify-between gap-3">
        <p id="fs-summary" class="text-sm text-muted" aria-live="polite">{cards.length}施設を表示しています</p>
        <button type="button" id="fs-reset" class="text-sm underline text-primary">条件をすべて解除</button>
      </div>
    </form>

    <div id="fs-empty" class="hidden mt-6 k-card p-6 text-sm">
      <p class="font-bold">この条件に合う施設はありませんでした。</p>
      <p class="mt-2 text-muted">どれかの条件をゆるめると候補が出ます。</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="fs-relax btn-secondary px-4 py-1.5 rounded-full border border-gray-300 dark:border-slate-700" data-relax="area">地域を全国にする</button>
        <button type="button" class="fs-relax btn-secondary px-4 py-1.5 rounded-full border border-gray-300 dark:border-slate-700" data-relax="type">種類を「すべて」にする</button>
        <button type="button" class="fs-relax btn-secondary px-4 py-1.5 rounded-full border border-gray-300 dark:border-slate-700" data-relax="closed">休業中の施設も表示する</button>
      </div>
    </div>

    <ul id="fs-results" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        cards.map((c) => (
          <li
            class="fs-card k-card flex flex-col"
            data-slug={c.slug}
            data-area={c.area}
            data-type={c.type}
            data-rental={c.rental}
            data-noreservation={c.noReservation}
            data-firsttimer={c.firstTimer}
            data-fish={c.fish}
            data-closures={c.closures}
          >
            <a href={c.href} class="block" data-placement={`facility-search-${c.slug}`}>
              <div class="relative h-44 bg-gray-200 dark:bg-slate-800">
                {c.image ? (
                  <Image src={c.image} alt={c.title} width={640} height={384} class="object-cover w-full h-full" loading="lazy" />
                ) : (
                  <div class="flex items-center justify-center w-full h-full text-gray-400">No Image</div>
                )}
                <span class="absolute top-2 left-2 px-2 py-0.5 bg-white/90 dark:bg-slate-800/90 rounded text-xs font-bold">
                  {c.prefName}・{TYPE_LABEL[c.type] ?? "分類確認中"}
                </span>
                <span class="fs-closed hidden absolute top-2 right-2 px-2 py-0.5 bg-slate-700/90 text-white rounded text-xs font-bold" />
              </div>
              <div class="p-4">
                <h3 class="text-lg font-bold leading-snug line-clamp-2">{c.title}</h3>
                <dl class="mt-3 grid grid-cols-[4.5em_1fr] gap-x-2 gap-y-1 text-xs">
                  <dt class="text-muted">料金</dt>
                  <dd class="line-clamp-2">{c.price || "施設記事で確認"}</dd>
                  <dt class="text-muted">予約</dt>
                  <dd class="line-clamp-1">{c.reservation || "施設記事で確認"}</dd>
                  <dt class="text-muted">確認日</dt>
                  <dd>{c.verifiedAt || "—"}</dd>
                </dl>
                <ul class="fs-reasons mt-3 flex flex-wrap gap-1.5 text-xs" />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <button type="button" id="fs-more" class="hidden btn-secondary px-8 py-2 rounded-full border border-gray-300 dark:border-slate-700 hover:bg-primary hover:text-white transition">もっと見る</button>
    </div>
    <p class="mt-6 text-xs text-muted">
      料金・予約は施設記事に載せた値で、確認日はその施設を公式で確かめた日です。定休日・臨時休業・空き状況は、出かける前に各施設の公式で確かめてください。
    </p>
  </section>

  <!-- 地域・県から探す（初期 HTML のリンク） ****************** -->
  <section id="areas" class="px-4 md:px-6 py-10 mx-auto max-w-7xl bg-k-sky-soft/60 rounded-3xl">
    <Headline title="地域・県から探す" subtitle="県のページでは、その県の施設をまとめて見られます。（ ）は施設数と、そのうちの海上釣り堀の数です。" />
    <div class="grid gap-6 md:grid-cols-2">
      {
        areaLinks.map((area) => (
          <div class="k-card p-5">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-bold text-lg">{area.name}</h3>
              <a href={area.ranking} class="text-sm text-primary underline" data-placement={`facility-area-ranking-${area.key}`}>
                {area.name}のおすすめランキング
              </a>
            </div>
            <ul class="mt-3 flex flex-wrap gap-2 text-sm">
              {area.prefs.map((p) => (
                <li>
                  <a href={p.href} class="inline-block px-3 py-1 rounded-full border border-gray-300 dark:border-slate-700 hover:bg-primary hover:text-white transition">
                    {p.name}（{p.count}・{p.ponds}）
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm">
      広い範囲のまとめ:
      <a href={getPermalink("/fishing-facility/east-japan")} class="text-primary underline">東日本</a>・
      <a href={getPermalink("/fishing-facility/center-japan")} class="text-primary underline">中日本</a>・
      <a href={getPermalink("/fishing-facility/west-japan")} class="text-primary underline">西日本</a>
    </p>
  </section>

  <!-- 地図 ****************** -->
  <section id="map-search" class="px-4 md:px-6 py-10 mx-auto max-w-7xl">
    <Headline
      title="地図から探す"
      subtitle="ピンの色は東日本(緑)・中日本(オレンジ)・西日本(青)。休業・休止中の施設は薄い色で場所だけ残しています。"
    />
    <div class="mt-4">
      <MapApp height="500px" />
    </div>
  </section>

  <script>
    import "~/scripts/facility-search.ts";
  </script>
</Layout>
