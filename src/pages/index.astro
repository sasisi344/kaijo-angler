---
// 2026-11-08 トップページ刷新: パステルの3カテゴリ（釣り場・攻略法・釣り旅）と「はじめての流れ」を軸にした構成。
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFishingFacilityEntries } from '~/utils/fishing-facility-collection';
import { travelRegions, travelNationwideId } from '~/data/travel-regions';

const metadata = {
  title: '海上アングラー — 全国の海上釣り堀ガイドと攻略法',
  ignoreTitleTemplate: true,
};

const toTime = (d: unknown) => (d ? new Date(d as string).getTime() : 0);
// 同じカバー画像を使う記事が多いので、タイルに同じ写真が並ばないよう画像で重複を除く
const uniqueByImage = <T extends { data: { image?: { src: string } } }>(list: T[]) => {
  const seen = new Set<string>();
  return list.filter((p) => {
    const src = p.data.image?.src;
    if (!src || seen.has(src)) return false;
    seen.add(src);
    return true;
  });
};

// 釣り場: 営業中で画像のある施設を、更新の新しい順に
const facilityEntries = (await getFishingFacilityEntries()).filter(
  (p) => !p.data.draft && !p.data.status && p.data.slug && p.data.category === '施設紹介'
);
const facilities = uniqueByImage(
  [...facilityEntries].sort(
    (a, b) => toTime(b.data.lastmod ?? b.data.publishDate) - toTime(a.data.lastmod ?? a.data.publishDate)
  )
)
  .slice(0, 5)
  .map((p) => ({ title: p.data.title, image: p.data.image, href: getPermalink(`fishing-facility/${p.data.slug}`) }));

// 攻略法: 主な魚種の攻略トップ
const tactics = await getCollection('tactics');
const fishOrder = ['madai', 'buri', 'kanpachi', 'shimaji', 'hiramasa'];
const fishPicks = fishOrder
  .map((slug) => tactics.find((t) => t.id === `fish-strategy/${slug}`))
  .filter((t): t is NonNullable<typeof t> => Boolean(t?.data.image))
  .map((t) => ({ title: t.data.title, image: t.data.image, href: getPermalink(`tactics/${t.id}`) }));

// 釣り旅: 新しい旅記事（アクセスガイドを除く）
const columns = await getCollection('column');
const travelAll = columns.filter((p) => !p.data.draft && p.id.startsWith('travel/'));
const travelPicks = uniqueByImage(
  travelAll
    .filter((p) => !p.id.startsWith('travel/access/'))
    .sort((a, b) => toTime(b.data.publishDate) - toTime(a.data.publishDate))
)
  .slice(0, 5)
  .map((p) => ({ title: p.data.title, image: p.data.image, href: getPermalink(`column/${p.id}`) }));

// はじめての人向けの5本
const beginnerOrder = ['first-fishing-pond', 'fishing-etiquette', 'safety-guide', 'fishing-gear-basics', 'fish-handling'];
const beginnerPicks = beginnerOrder
  .map((slug) => tactics.find((t) => t.id === `beginner/${slug}`))
  .filter((t): t is NonNullable<typeof t> => Boolean(t))
  .map((t) => ({ title: t.data.title.split('｜')[0].replace(/^【[^】]*】/, ''), href: getPermalink(`tactics/${t.id}`) }));

const counts = {
  facilities: facilityEntries.length,
  tactics: tactics.filter((t) => !t.data.draft).length,
  travel: travelAll.length,
};

const categories = [
  {
    key: 'facility',
    en: 'Facility',
    label: '釣り場を探す',
    vertical: 'エリアで探す',
    lead: '全国の施設から',
    title: '海上釣り堀ガイド',
    href: getPermalink('/fishing-facility'),
    color: 'bg-k-sky',
    soft: 'bg-k-sky-soft',
    items: facilities,
    note: `${counts.facilities}施設`,
  },
  {
    key: 'tactics',
    en: 'Tactics',
    label: '攻略法を学ぶ',
    vertical: '魚種別攻略',
    lead: 'もう一匹を釣る',
    title: '必釣タクティクス',
    href: getPermalink('/tactics'),
    color: 'bg-k-sun',
    soft: 'bg-k-sun-soft',
    items: fishPicks,
    note: `${counts.tactics}本`,
  },
  {
    key: 'travel',
    en: 'Travel',
    label: '釣り旅に出る',
    vertical: '旅と釣り',
    lead: '観光と組み合わせる',
    title: '釣り旅ガイド',
    href: getPermalink('/column/travel'),
    color: 'bg-k-coral',
    soft: 'bg-k-coral-soft',
    items: travelPicks,
    note: `${counts.travel}本`,
  },
];

const steps = [
  {
    no: '01',
    color: 'var(--k-sky)',
    text: '釣り場を選んで、<br />予約の方法を確かめます。',
    icon: 'calendar',
  },
  {
    no: '02',
    color: 'var(--k-sun)',
    text: '仕掛けとエサを用意します。<br />竿を借りられる施設もあります。',
    icon: 'rod',
  },
  {
    no: '03',
    color: 'var(--k-coral)',
    text: '釣った魚を持ち帰って、<br />おいしくいただきます。',
    icon: 'fish',
  },
];

const areas = [
  { name: '東日本', en: 'East', note: '北海道・東北・関東', href: getPermalink('/fishing-facility/east-japan'), color: 'bg-k-sky' },
  { name: '中日本', en: 'Center', note: '東海・北陸・甲信', href: getPermalink('/fishing-facility/center-japan'), color: 'bg-k-mint' },
  { name: '西日本', en: 'West', note: '近畿・中国・四国・九州・沖縄', href: getPermalink('/fishing-facility/west-japan'), color: 'bg-k-coral' },
];
---

<Layout metadata={metadata}>
  <!-- ヒーロー: 3色のパネル＋大きな英字 -->
  <section class="relative not-prose">
    <div class="grid grid-cols-3">
      {
        categories.map((c, i) => (
          <a href={c.href} class:list={['group relative block overflow-hidden', c.color]}>
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-white/70 [clip-path:polygon(0_40%,100%_0,100%_100%,0_100%)]" aria-hidden="true" />
            <div class="relative flex items-end justify-center h-48 sm:h-80 lg:h-[28rem] px-2 sm:px-6 pt-20 sm:pt-32 lg:pt-40 pb-5 sm:pb-6">
              {c.items[0]?.image && (
                <div class="w-24 h-24 sm:w-52 sm:h-52 lg:w-72 lg:h-72 rounded-full overflow-hidden shadow-[0_18px_30px_-18px_rgb(0_0_0/45%)] transition duration-300 group-hover:scale-[1.03]">
                  <Image
                    src={c.items[0].image}
                    alt={c.items[0].title}
                    class="w-full h-full object-cover"
                    widths={[320, 480, 640]}
                    width={480}
                    height={480}
                    sizes="(max-width: 640px) 50vw, 33vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-4 sm:top-8 text-center px-4">
      <p class="font-en font-semibold text-white text-3xl sm:text-6xl lg:text-7xl tracking-[0.15em] sm:tracking-[0.2em] leading-tight drop-shadow-[0_2px_0_rgb(0_0_0/8%)]">
        KAIJO ANGLER
      </p>
      <p class="font-en text-white text-[0.65rem] sm:text-xl tracking-[0.3em] sm:tracking-[0.35em] mt-1">SEA FISHING POND GUIDE</p>
    </div>
  </section>

  <!-- キャッチコピー＋3つのメニュー -->
  <section class="bg-white not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 text-center">
      <h1 class="text-2xl md:text-3xl font-bold leading-relaxed">海とつながる、最高の休日を。</h1>
      <p class="mt-3 text-sm md:text-base text-muted">
        全国の海上釣り堀を探して、攻略法で準備して、旅と一緒に楽しむためのガイドです。
      </p>
    </div>
    <nav aria-label="カテゴリ" class="max-w-6xl mx-auto px-4 sm:px-6 pb-8">
      <ul class="grid grid-cols-3 border-y border-dashed border-[color:var(--k-line)]">
        {
          categories.map((c, i) => (
            <li class:list={['text-center', { 'border-l border-dashed border-[color:var(--k-line)]': i > 0 }]}>
              <a href={c.href} class="block py-4 hover:bg-cream transition">
                <span class="block font-heading font-bold text-sm sm:text-base">{c.label}</span>
                <span class="en-label block !text-[0.6rem] mt-1">{c.en}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <!-- カテゴリのタイル -->
  <section class="not-prose">
    <div class="grid grid-cols-1 md:grid-cols-3">
      {
        categories.map((c) => (
          <div>
            <div class="grid grid-cols-3">
              <a href={c.href} class:list={['aspect-square flex items-center justify-center', c.color]}>
                <span class="font-heading font-bold text-heading text-lg tracking-[0.3em] [writing-mode:vertical-rl]">{c.vertical}</span>
              </a>
              {c.items.slice(1, 3).map((it) => (
                <a href={it.href} class:list={['aspect-square overflow-hidden block', c.soft]} title={it.title}>
                  {it.image && (
                    <Image src={it.image} alt={it.title} class="w-full h-full object-cover transition duration-300 hover:scale-105" widths={[240, 400]} width={300} height={300} sizes="(max-width: 768px) 33vw, 11vw" loading="lazy" />
                  )}
                </a>
              ))}
            </div>
            <a href={c.href} class:list={['flex flex-col items-center justify-center py-8 sm:py-10 group', c.soft]}>
              <span class="text-xs text-muted border-b border-current px-2 pb-1">{c.lead}</span>
              <span class="mt-3 font-heading font-bold text-xl md:text-2xl flex items-center gap-3">
                <span class="k-dots w-8 inline-block" aria-hidden="true" />
                {c.title}
              </span>
              <span class="mt-2 text-xs text-muted">{c.note}　→</span>
            </a>
            <div class="grid grid-cols-3">
              {c.items.slice(3, 5).concat(c.items.slice(0, 1)).map((it) => (
                <a href={it.href} class:list={['aspect-square overflow-hidden block', c.soft]} title={it.title}>
                  {it.image && (
                    <Image src={it.image} alt={it.title} class="w-full h-full object-cover transition duration-300 hover:scale-105" widths={[240, 400]} width={300} height={300} sizes="(max-width: 768px) 33vw, 11vw" loading="lazy" />
                  )}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- はじめての流れ -->
  <section class="not-prose max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-24">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold">はじめての海上釣り堀</h2>
      <p class="en-label mt-2">Basic</p>
    </div>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6">
      {
        steps.map((s, i) => (
          <li class="relative">
            <p class="font-en font-semibold text-5xl leading-none" style={`color:${s.color}`}>
              <span class="text-base align-top mr-1 italic">process</span>
              <span style={`-webkit-text-stroke:2px ${s.color};color:transparent`}>{s.no}</span>
            </p>
            <div class="mt-3 bg-white rounded-[48%_52%_45%_55%/55%_45%_55%_45%] aspect-[4/3] flex items-center justify-center">
              {s.icon === 'calendar' && (
                <svg viewBox="0 0 120 90" class="w-1/2 text-heading" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="22" y="18" width="62" height="56" rx="6" />
                  <path d="M22 32h62M38 12v12M68 12v12" />
                  <path d="M40 52l8 8 16-16" />
                  <path d="M92 30c6 2 10 8 10 14M96 22c9 3 14 12 14 22" />
                </svg>
              )}
              {s.icon === 'rod' && (
                <svg viewBox="0 0 120 90" class="w-1/2 text-heading" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 80L92 10" />
                  <path d="M92 10c6 10 8 26 8 44" />
                  <path d="M100 54c0 6-6 8-8 3" />
                  <circle cx="34" cy="65" r="6" />
                  <path d="M10 84h40" />
                </svg>
              )}
              {s.icon === 'fish' && (
                <svg viewBox="0 0 120 90" class="w-1/2 text-heading" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <ellipse cx="60" cy="66" rx="46" ry="10" />
                  <path d="M28 50c10-14 32-18 48-8l12-8v22l-12-8c-16 10-38 6-48-6" />
                  <circle cx="40" cy="48" r="1.8" fill="currentColor" />
                  <path d="M52 20c2-6 6-8 10-8M66 22c3-5 8-6 12-5" />
                </svg>
              )}
            </div>
            <p class="mt-4 text-sm md:text-base leading-relaxed" set:html={s.text} />
            {i < steps.length - 1 && <span class="hidden md:block k-dots w-10 absolute top-1/2 -right-8" aria-hidden="true" />}
          </li>
        ))
      }
    </ol>

    <!-- 読んでおきたい5本 -->
    <div class="mt-20 text-center">
      <p class="text-sm font-heading">はじめてでも安心して楽しむために</p>
      <h2 class="mt-1 text-2xl md:text-3xl font-bold inline-flex items-center gap-4">
        <span class="w-10 h-px bg-[color:var(--aw-color-text-heading)] rotate-[60deg]" aria-hidden="true" />
        読んでおきたい<span class="text-4xl">5</span>本
        <span class="w-10 h-px bg-[color:var(--aw-color-text-heading)] -rotate-[60deg]" aria-hidden="true" />
      </h2>
      <p class="en-label mt-1">Guide</p>
    </div>
    <ol class="mt-8 max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 text-sm md:text-base">
      {
        beginnerPicks.map((b, i) => (
          <li class="flex gap-3">
            <span class="font-en font-semibold">{String(i + 1).padStart(2, '0')}.</span>
            <a href={b.href} class="hover:text-primary underline decoration-dotted underline-offset-4">{b.title}</a>
          </li>
        ))
      }
    </ol>
    <div class="relative mt-12 max-w-3xl mx-auto bg-white px-6 py-8 text-center">
      <span class="absolute -top-3 -left-3 w-12 border-t-2 border-dashed border-[color:var(--k-line)] rotate-[-45deg]" aria-hidden="true" />
      <span class="absolute -bottom-3 -right-3 w-12 border-t-2 border-dashed border-[color:var(--k-line)] rotate-[-45deg]" aria-hidden="true" />
      <p class="text-sm text-muted">持ち物・当日の流れ・釣り方までをひとつにまとめています。</p>
      <a href={getPermalink('/tactics/beginner')} class="btn-primary mt-4">初心者ガイドを読む</a>
    </div>
  </section>

  <!-- エリアから探す -->
  <section class="not-prose bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold">エリアから釣り場を探す</h2>
        <p class="en-label mt-2">Area</p>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          areas.map((a) => (
            <li>
              <a href={a.href} class:list={['block rounded-3xl px-6 py-8 text-center transition hover:-translate-y-1', a.color]}>
                <span class="en-label !text-muted">{a.en}</span>
                <span class="block mt-1 font-heading font-bold text-2xl">{a.name}</span>
                <span class="block mt-2 text-sm text-muted">{a.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 text-center">
        <p class="font-heading font-bold">釣り旅ガイドを地域で選ぶ</p>
        <ul class="mt-4 flex flex-wrap justify-center gap-2">
          {
            travelRegions.map((r) => (
              <li>
                <a href={`${getPermalink('/column/travel')}#${r.id}`} class="inline-block rounded-full bg-k-coral-soft px-5 py-2 text-sm font-heading font-bold hover:bg-k-coral transition">
                  {r.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`${getPermalink('/column/travel')}#${travelNationwideId}`} class="inline-block rounded-full bg-cream px-5 py-2 text-sm font-heading font-bold hover:bg-k-sun-soft transition">
              全国・旅の準備
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
