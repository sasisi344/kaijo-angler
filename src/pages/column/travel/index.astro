---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Headline from '~/components/blog/Headline.astro';
import PostCard from './_PostCard.astro';
import { getPermalink } from '~/utils/permalinks';
import { travelRegions, travelNationwideId } from '~/data/travel-regions';

const allColumn = await getCollection('column');

const travelPosts = allColumn
  .filter((post) => !post.data.draft && post.id.startsWith('travel/'))
  .sort((a, b) => new Date(b.data.publishDate ?? 0).getTime() - new Date(a.data.publishDate ?? 0).getTime());

// 地域ごとに、旅の記事（新しい順）→ アクセスガイドの順で並べる
const isAccessGuide = (id: string) => id.startsWith('travel/access/');
const order = (id: string) => (isAccessGuide(id) ? 1 : 0);
const regionSections = travelRegions.map((r) => ({
  ...r,
  posts: travelPosts
    .filter((p) => r.slugs.includes(p.id.replace(/^travel\//, '')))
    .sort((a, b) => order(a.id) - order(b.id)),
}));
const assigned = new Set(travelRegions.flatMap((r) => r.slugs));
const nationwide = travelPosts
  .filter((p) => !assigned.has(p.id.replace(/^travel\//, '')))
  .sort((a, b) => order(a.id) - order(b.id));
const regionColors = ['bg-k-sky', 'bg-k-sun', 'bg-k-coral', 'bg-k-mint', 'bg-k-sky-soft'];

const metadata = {
  title: '釣り旅ガイド — 遠征×釣りのモデルコース集 | 海上アングラー',
  description:
    '海上釣り堀を軸にした遠征・旅行プランを地域別・季節別にまとめました。家族旅行やご当地グルメと組み合わせたモデルコース、現地までのアクセス方法までまとめています。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="釣り旅ガイド"
    title="遠征・旅行×釣り"
    subtitle={`釣るだけじゃもったいない。<strong>${travelPosts.length}本以上</strong>の記事で、海上釣り堀を軸にした旅行プランをご紹介。地域のグルメや観光と組み合わせた家族旅行モデルコースから、季節ごとのおすすめプラン、現地までのアクセス方法まで、遠征釣行の計画に役立つ情報を網羅しています。`}
  />

  <!-- 地域メニュー（ヘッダーの「釣り旅ガイド」からも同じアンカーへ飛ぶ） -->
  <nav aria-label="地域で選ぶ" class="px-4 sm:px-6 mx-auto max-w-5xl -mt-4 mb-4">
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {
        regionSections.map((r, i) => (
          <li>
            <a
              href={`#${r.id}`}
              class:list={['block rounded-2xl px-3 py-4 text-center font-heading font-bold text-heading transition hover:-translate-y-0.5', regionColors[i % regionColors.length]]}
            >
              {r.name}
              <span class="block text-xs font-normal text-muted mt-1">{r.posts.length}本</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={`#${travelNationwideId}`} class="block rounded-2xl px-3 py-4 text-center font-heading font-bold text-heading bg-white transition hover:-translate-y-0.5">
          全国・旅の準備
          <span class="block text-xs font-normal text-muted mt-1">{nationwide.length}本</span>
        </a>
      </li>
    </ul>
  </nav>

  {
    regionSections.map((r, i) => (
      <section id={r.id} class="scroll-mt-24 px-4 sm:px-6 py-12 mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end gap-x-4 gap-y-1 mb-6">
          <h2 class="text-2xl md:text-3xl font-bold font-heading">
            <span class:list={['inline-block px-4 py-1 rounded-full mr-2', regionColors[i % regionColors.length]]}>{r.name}</span>
            の釣り旅
          </h2>
          <p class="text-sm text-muted">{r.areas}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {r.posts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    ))
  }

  {
    nationwide.length > 0 && (
      <section id={travelNationwideId} class="scroll-mt-24 px-4 sm:px-6 py-12 mx-auto max-w-7xl">
        <Headline as="h2" en="Nationwide" title="全国の季節特集・旅の準備" subtitle="地域を問わない季節のおすすめ、遠征の段取り、釣った魚の持ち帰り方などをまとめました。" />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {nationwide.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 py-16">
    <div class="bg-k-mint-soft p-8 md:p-12 rounded-3xl text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">旅の行き先を決めたら、釣り場をチェック！</h2>
      <p class="text-lg text-muted mb-8 max-w-2xl mx-auto">
        全国<strong>100施設以上・50エリア以上</strong>の海上釣り堀から、家族連れにも安心な設備充実の施設を探せます。
      </p>
      <a href={getPermalink('fishing-facility')} class="btn-primary py-3 px-8 text-xl">釣り場を探す</a>
    </div>
  </section>
</Layout>
