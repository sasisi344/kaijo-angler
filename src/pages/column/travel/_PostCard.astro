---
import Image from '~/components/common/Image.astro';
import type { CollectionEntry } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

interface Props {
  post: CollectionEntry<'column'>;
}

const { post } = Astro.props;
const publishDate = post.data.publishDate ? new Date(post.data.publishDate) : undefined;
const dateLabel = publishDate
  ? new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long' }).format(publishDate)
  : undefined;
const href = getPermalink(`column/${post.id}`);
---

<article class="k-card flex flex-col">
  <a href={href} class="block h-full flex flex-col">
    <div class="relative h-44 bg-k-sky-soft">
      {
        post.data.image && (
          <Image
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-full object-cover"
            widths={[400, 800]}
            width={400}
            sizes="(max-width: 900px) 400px, 800px"
            aspectRatio="16:9"
            layout="cover"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
    <div class="p-5 flex-grow flex flex-col">
      {dateLabel && <span class="text-xs text-primary font-bold mb-1">{dateLabel}</span>}
      <h3 class="text-base font-bold mb-2 leading-relaxed line-clamp-2">{post.data.title}</h3>
      <p class="text-sm text-muted line-clamp-3">{post.data.description}</p>
    </div>
  </a>
</article>
