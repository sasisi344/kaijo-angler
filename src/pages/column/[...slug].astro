---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';

export async function getStaticPaths() {
  const posts = await getCollection('column');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const rendered = await render(post);
const Content = rendered.Content;
const image = (await findImage(post.data.image)) as ImageMetadata | string | undefined;

const metadata = {
  title: post.data.title,
  description: post.data.description,
  ...(image
    ? {
        openGraph: {
          type: 'article',
          images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }],
        },
      }
    : {}),
} as MetaData;
---

<Layout metadata={metadata}>
  <Hero
    tagline={post.data.category}
    title={post.data.title}
    image={post.data.image ? { src: post.data.image, alt: post.data.title } : undefined}
  >
    <Fragment slot="subtitle">
      {post.data.description}
    </Fragment>
  </Hero>

  <article class="px-6 py-16 mx-auto max-w-4xl">
    <div class="prose prose-lg prose-md dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Layout>
