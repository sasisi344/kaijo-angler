---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import GlobalSearch from '~/components/common/GlobalSearch.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// スマホメニューのカテゴリ見出し（色と英字ラベル）
const mobileColors = ['bg-k-sky', 'bg-k-sun', 'bg-k-coral', 'bg-k-mint'];
const mobileSoft = ['bg-k-sky-soft', 'bg-k-sun-soft', 'bg-k-coral-soft', 'bg-k-mint-soft'];
const mobileEn: Record<string, string> = { 釣り場を探す: 'Facility', 攻略法: 'Tactics', 釣り旅ガイド: 'Travel' };
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-[1100] flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center']}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center mm:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full mm:w-auto hidden mm:flex mm:mx-5 text-default overflow-y-auto overflow-x-hidden mm:overflow-y-visible mm:overflow-x-auto mm:justify-self-center"
      aria-label="Main navigation"
    >
      <!-- スマホ用メニュー（ハンバーガーを開いたとき） -->
      <div class="mm:hidden w-full px-4 pt-4 pb-10">
        <GlobalSearch />
        <a
          href={getHomePermalink()}
          class="mt-4 flex items-center justify-between rounded-2xl bg-white px-4 py-3 font-heading font-bold"
        >
          ホーム
          <Icon name="tabler:chevron-right" class="w-4 h-4 text-muted" />
        </a>
        {
          links
            .filter((l) => l.links?.length)
            .map(({ text, links: children = [] }, i) => (
              <section class="mt-6">
                <h2 class="flex items-baseline gap-2 mb-2 px-1">
                  <span class:list={['w-2.5 h-2.5 rounded-full self-center', mobileColors[i % mobileColors.length]]} aria-hidden="true" />
                  <span class="font-heading font-bold text-base">{text}</span>
                  <span class="en-label !text-[0.55rem]">{mobileEn[text ?? ''] ?? ''}</span>
                </h2>
                <ul class="grid grid-cols-2 gap-2">
                  {children.map(({ text: t2, href: h2 }, j) => (
                    <li class:list={{ 'col-span-2': j === 0 }}>
                      <a
                        href={h2}
                        class:list={[
                          'flex items-center justify-between rounded-xl px-3 py-2.5 text-sm leading-snug',
                          j === 0 ? `${mobileSoft[i % mobileSoft.length]} font-bold` : 'bg-white',
                          { 'aw-link-active': h2 === currentPath },
                        ]}
                      >
                        {t2}
                        <Icon name="tabler:chevron-right" class="w-3.5 h-3.5 shrink-0 text-muted" />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
        }
        {
          showRssFeed && (
            <a href={getAsset('/facilities-rss.xml')} class="mt-8 inline-flex items-center gap-1 text-xs text-muted">
              <Icon name="tabler:rss" class="w-4 h-4" />
              釣り場更新RSS
            </a>
          )
        }
      </div>
      <ul
        class="hidden mm:flex mm:flex-row mm:self-center mm:w-auto mm:text-[0.9375rem] tracking-[0.01rem] font-medium mm:justify-center"
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden mm:inline" />
                  </button>
                  <ul class="dropdown-menu mm:backdrop-blur-md dark:mm:bg-dark rounded mm:absolute pl-4 mm:pl-0 mm:hidden font-medium mm:bg-white/90 mm:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b mm:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden mm:self-center mm:flex items-center mm:mb-0 mm:static justify-end mm:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full mm:w-auto">
        <div class="flex items-center">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 mm:w-5 mm:h-5 mm:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/facilities-rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        <div class="hidden mm:flex items-center ml-2">
          <GlobalSearch />
        </div>
      </div>
    </div>
  </div>
</header>
