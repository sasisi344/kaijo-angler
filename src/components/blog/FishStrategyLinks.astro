---
/**
 * 施設記事の本文のあとに出す「この施設で狙える魚の釣り方」。
 * 釣り方（タナ）は施設のイケスで違うので施設ごとには書かず、海上釣り堀の主な魚（マダイ・青物・シマアジ）を
 * frontmatter の target_fish から拾って、魚種別攻略へつなぐ（2026-11-19 筆者決定）。
 */
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

interface Props {
  facilityId: string;
  targetFish?: string[];
}

const { facilityId, targetFish = [] } = Astro.props;

// 施設の対象魚の書き方 → 魚種別攻略の slug
const MAIN_FISH: { slug: string; name: string; match: RegExp }[] = [
  { slug: 'madai', name: 'マダイ', match: /マダイ|真鯛/ },
  { slug: 'buri', name: 'ブリ（ハマチ・ワラサ）', match: /ブリ|ハマチ|ワラサ|メジロ|イナダ/ },
  { slug: 'kanpachi', name: 'カンパチ', match: /カンパチ/ },
  { slug: 'hiramasa', name: 'ヒラマサ', match: /ヒラマサ/ },
  { slug: 'shimaji', name: 'シマアジ', match: /シマアジ/ },
];

const tactics = await getCollection('tactics');
const links = MAIN_FISH.filter((f) => targetFish.some((t) => f.match.test(t)))
  .filter((f) => tactics.some((t) => t.id === `fish-strategy/${f.slug}` && !t.data.draft))
  .map((f) => ({ ...f, href: getPermalink(`tactics/fish-strategy/${f.slug}`) }));

if (links.length === 0) return;
---

<aside class="not-prose mt-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-5 py-4">
  <p class="font-bold text-slate-800 dark:text-slate-100">この施設で狙える魚の釣り方</p>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
    タナ（魚のいる深さ）はイケスごとに違うので、当日はスタッフに聞いて合わせます。仕掛けとエサの選び方は、魚ごとの攻略にまとめています。
  </p>
  <ul class="mt-3 flex flex-wrap gap-2 text-sm">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class="inline-block px-3 py-1 rounded-full border border-slate-300 dark:border-slate-600 hover:bg-primary hover:text-white transition"
            data-placement={`facility-fish-${l.slug}`}
            data-facility={facilityId}
          >
            {l.name}の釣り方
          </a>
        </li>
      ))
    }
  </ul>
</aside>
