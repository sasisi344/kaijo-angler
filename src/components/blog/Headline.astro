---
// en: 見出しの下に添える英字ラベル（任意）。例: en="Travel"
const {
  title = await Astro.slots.render('default'),
  subtitle = await Astro.slots.render('subtitle'),
  en,
  as: Tag = 'h1',
} = Astro.props;
---

<header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
  <Tag class="text-3xl md:text-4xl font-bold leading-snug font-heading" set:html={title} />
  {en && <p class="en-label mt-2">{en}</p>}
  {
    subtitle && (
      <div class="mt-4 mx-auto text-base md:text-lg text-muted" set:html={subtitle} />
    )
  }
</header>
