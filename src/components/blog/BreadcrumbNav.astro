---
import type { FacilityBreadcrumbItem } from '~/utils/fishing-facility-areas';

interface Props {
  items: FacilityBreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="パンくず" class="mx-auto max-w-4xl px-6 pt-8 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((crumb, i) => (
        <li class="inline-flex items-center gap-2">
          {i > 0 && (
            <span class="text-slate-400 dark:text-slate-500" aria-hidden="true">
              /
            </span>
          )}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-primary transition-colors">
              {crumb.name}
            </a>
          ) : (
            <span class="text-default font-medium" aria-current="page">
              {crumb.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
